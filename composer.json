{
  "name": "wexample/symfony-remote-peppol",
  "description": "Peppol e-delivery through an access point: participants, documents, transmissions, inbox and webhooks, whatever the provider",
  "type": "library",
  "license": "MIT",
  "version": "2.0.6",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemotePeppol\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemotePeppol\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=19.1.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}